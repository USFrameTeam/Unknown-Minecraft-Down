{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unknown Minecraft Down",
  "version": "0.3.0",
  "identifier": "io.github.unknown-minecraft-down",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unknown Minecraft Down",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
